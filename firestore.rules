rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      // Oricine a intrat pe pagină (autentificat anonim) poate vedea mesele.
      allow read: if request.auth != null;

      // Poți crea o masă doar ca gazdă, cu tine singur la ea.
      allow create: if request.auth != null
        && code.size() == 4
        && request.resource.data.host == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid];

      // Modifică masa doar cei care stau la ea,
      // sau cineva care se așază la o masă în așteptare (max. 4 jucători).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.playerIds
        || (resource.data.status == 'lobby'
            && request.resource.data.playerIds.size() <= 4
            && request.auth.uid in request.resource.data.playerIds)
      );

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.playerIds;
    }
  }
}
